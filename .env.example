# Relay Next-Hop configuration (optional: if this server forwards traffic to downstream VLESS nodes)
# Can be an HTTP/HTTPS subscription URL or raw VLESS URIs (separated by newlines, commas, or spaces).
# If this server's own node is present in the subscription, it is automatically detected and skipped to prevent self-looping.
# NEXT_HOP=
# NEXT_HOP_UPDATE_INTERVAL=
# NEXT_HOP_PROBE_URL=
# NEXT_HOP_PROBE_INTERVAL=
