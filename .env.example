# Mode: vless-reality-xhttp or vless-reality-tcp
MODE=vless-reality-xhttp

# Server display name (optional, defaults to COMPOSE_PROJECT_NAME or HOST)
SERVER_NAME=

HOST=
PORT=
SNIS=
FALLBACK_PROXY_TARGET=
FINGERPRINT=
XHTTP_PATH=/
XHTTP_MODE=auto
NUMBER_OF_USERS=
SEED=
WHITELIST_DOMAINS=

# Supabase integration (optional: syncs generated VLESS URIs and hourly traffic stats)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVER_UUID=

# Relay Next-Hop configuration (optional: if this server forwards traffic to downstream VLESS nodes)
# Can be an HTTP/HTTPS subscription URL or raw VLESS URIs (separated by newlines, commas, or spaces).
# If this server's own node is present in the subscription, it is automatically detected and skipped to prevent self-looping.
# NEXT_HOP=
# NEXT_HOP_UPDATE_INTERVAL=3600
# NEXT_HOP_PROBE_URL=http://cp.cloudflare.com/generate_204
# NEXT_HOP_PROBE_INTERVAL=1m
